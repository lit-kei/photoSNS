rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isGroupMember(groupId) {
      return signedIn()
        && exists(/databases/$(database)/documents/groups/$(groupId))
        && request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.memberIds;
    }

    function isGroupOwner(groupId) {
      return signedIn()
        && exists(/databases/$(database)/documents/groups/$(groupId))
        && get(/databases/$(database)/documents/groups/$(groupId)).data.ownerId == request.auth.uid;
    }

    function isSelfGroupMemberDocument(memberId, memberData) {
      return signedIn()
        && memberData.groupId is string
        && memberData.userId == request.auth.uid
        && memberId == memberData.groupId + "_" + request.auth.uid;
    }

    function isSelfMemberInGroupAfter(memberData) {
      return existsAfter(/databases/$(database)/documents/groups/$(memberData.groupId))
        && request.auth.uid in getAfter(/databases/$(database)/documents/groups/$(memberData.groupId)).data.memberIds;
    }

    function isCreatorOnlyGroup(groupData) {
      return signedIn()
        && groupData.ownerId == request.auth.uid
        && groupData.memberIds is list
        && groupData.memberIds.size() == 1
        && groupData.memberIds[0] == request.auth.uid;
    }

    function isJoiningSelf() {
      return signedIn()
        && !(request.auth.uid in resource.data.memberIds)
        && request.auth.uid in request.resource.data.memberIds
        && request.resource.data.diff(resource.data).changedKeys().hasOnly([
          "memberIds",
          "memberNames",
          "memberAvatars"
        ])
        && request.resource.data.memberIds.size() == resource.data.memberIds.size() + 1
        && request.resource.data.memberIds.hasAll(resource.data.memberIds)
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.inviteCode == resource.data.inviteCode;
    }

    function stickerTarget(stickerData) {
      return stickerData.keys().hasAny(['target']) ? stickerData.target : 'group';
    }

    function isBlogVisible(authorId) {
      return signedIn()
        && (
          request.auth.uid == authorId
          || exists(/databases/$(database)/documents/friendships/$(request.auth.uid + "_" + authorId))
        );
    }

    function hasValidEditLockShape(lockData, diaryId) {
      return lockData.keys().hasOnly([
          "groupId",
          "diaryId",
          "lockedBy",
          "lockedByName",
          "expiresAt",
          "updatedAt"
        ])
        && lockData.groupId is string
        && lockData.diaryId == diaryId
        && lockData.lockedBy == request.auth.uid
        && lockData.lockedByName is string
        && lockData.expiresAt is timestamp
        && lockData.expiresAt > request.time
        && lockData.expiresAt <= request.time + duration.value(5, "m");
    }

    match /users/{userId} {
      allow read: if signedIn();
      allow create, update: if signedIn() && request.auth.uid == userId;
    }

    match /groups/{groupId} {
      allow read: if signedIn();
      allow create: if isCreatorOnlyGroup(request.resource.data);
      allow update: if isGroupMember(groupId) || isJoiningSelf();
      allow delete: if signedIn()
        && request.auth.uid in resource.data.memberIds
        && resource.data.memberIds.size() == 1;
    }

    match /groupMembers/{memberId} {
      allow read: if signedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSelfGroupMemberDocument(memberId, request.resource.data)
        && isSelfMemberInGroupAfter(request.resource.data);
      allow update: if isSelfGroupMemberDocument(memberId, request.resource.data)
        && request.resource.data.groupId == resource.data.groupId
        && isSelfMemberInGroupAfter(request.resource.data);
      allow update: if isGroupOwner(resource.data.groupId)
        && request.resource.data.diff(resource.data).changedKeys().hasOnly(['role'])
        && request.resource.data.role == "owner";
      allow delete: if signedIn() && resource.data.userId == request.auth.uid;
    }

    match /diaries/{diaryId} {
      allow read: if signedIn()
        && (
          resource == null
          || isGroupMember(resource.data.groupId)
        );

      allow create: if isGroupMember(request.resource.data.groupId);

      allow update: if isGroupMember(resource.data.groupId)
        && request.resource.data.groupId == resource.data.groupId;
    }

    match /stickers/{stickerId} {
      allow read: if (stickerTarget(resource.data) == 'group' && isGroupMember(resource.data.groupId))
        || (stickerTarget(resource.data) == 'blog' && isBlogVisible(resource.data.authorId));
      allow create: if signedIn()
        && request.auth.uid == request.resource.data.authorId
        && (
          (stickerTarget(request.resource.data) == 'group' && isGroupMember(request.resource.data.groupId))
          || (
            stickerTarget(request.resource.data) == 'blog'
            && request.resource.data.groupId == ''
            && request.resource.data.diaryId == ''
          )
        );
      allow delete: if signedIn() && request.auth.uid == resource.data.authorId;
      allow update: if false;
    }

    match /stickerAssets/{assetId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.auth.uid == request.resource.data.ownerId
        && request.resource.data.referenceCount > 0;
      allow update: if signedIn()
        && request.auth.uid == resource.data.ownerId
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.referenceCount > 0;
      allow delete: if signedIn() && request.auth.uid == resource.data.ownerId;
    }

    match /stickerReports/{reportId} {
      allow create: if signedIn()
        && request.resource.data.reporterId == request.auth.uid
        && reportId == request.resource.data.stickerId + "_" + request.auth.uid
        && request.resource.data.reason == "inappropriate_image"
        && request.resource.data.status == "open";
      allow read, update, delete: if false;
    }

    // The app checks deterministic IDs before creating these documents.
    // Authenticated reads must therefore also work when a document is absent.
    match /friendships/{friendshipId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && (request.auth.uid == request.resource.data.userId
          || request.auth.uid == request.resource.data.friendId);
      allow delete: if signedIn()
        && (request.auth.uid == resource.data.userId
          || request.auth.uid == resource.data.friendId);
      allow update: if false;
    }

    match /friendRequests/{requestId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.auth.uid == request.resource.data.fromUserId
        && request.resource.data.status == "pending";
      allow update: if signedIn()
        && request.resource.data.fromUserId == resource.data.fromUserId
        && request.resource.data.toUserId == resource.data.toUserId
        && (
          (request.auth.uid == resource.data.toUserId
            && request.resource.data.status in ["accepted", "rejected"])
          || (request.auth.uid == resource.data.fromUserId
            && request.resource.data.status == "pending")
        );
      allow delete: if signedIn()
        && (request.auth.uid == resource.data.fromUserId
          || request.auth.uid == resource.data.toUserId);
    }

    match /notifications/{notificationId} {
      allow read, update, delete: if signedIn()
        && request.auth.uid == resource.data.userId;
      allow create: if signedIn();
    }

    match /editLocks/{diaryId} {
      allow read: if signedIn()
        && (
          resource == null
          || isGroupMember(resource.data.groupId)
        );
      allow create: if hasValidEditLockShape(request.resource.data, diaryId)
        && isGroupMember(request.resource.data.groupId);
      allow update: if hasValidEditLockShape(request.resource.data, diaryId)
        && isGroupMember(request.resource.data.groupId)
        && request.resource.data.groupId == resource.data.groupId
        && request.resource.data.diaryId == resource.data.diaryId
        && (
          resource.data.lockedBy == request.auth.uid
          || resource.data.expiresAt <= request.time
        );
      allow delete: if isGroupMember(resource.data.groupId)
        && resource.data.lockedBy == request.auth.uid;
    }
  }
}
