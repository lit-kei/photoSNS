rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isGroupMember(groupId) {
      return signedIn()
        && exists(/databases/$(database)/documents/groups/$(groupId))
        && request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.memberIds;
    }

    function isGroupOwner(groupId) {
      return signedIn()
        && exists(/databases/$(database)/documents/groups/$(groupId))
        && get(/databases/$(database)/documents/groups/$(groupId)).data.ownerId == request.auth.uid;
    }

    function isSelfGroupMemberDocument(memberId, memberData) {
      return signedIn()
        && memberData.groupId is string
        && memberData.userId == request.auth.uid
        && memberId == memberData.groupId + "_" + request.auth.uid;
    }

    function hasValidEditLockShape(lockData, diaryId) {
      return lockData.keys().hasOnly([
          "groupId",
          "diaryId",
          "lockedBy",
          "lockedByName",
          "expiresAt",
          "updatedAt"
        ])
        && lockData.groupId is string
        && lockData.diaryId == diaryId
        && lockData.lockedBy == request.auth.uid
        && lockData.lockedByName is string
        && lockData.expiresAt is timestamp
        && lockData.expiresAt > request.time
        && lockData.expiresAt <= request.time + duration.value(5, "m");
    }

    match /users/{userId} {
      allow read: if signedIn();
      allow create, update: if signedIn() && request.auth.uid == userId;
    }

    match /groups/{groupId} {
      allow read: if signedIn();
      allow create: if signedIn();
      allow update: if signedIn();
      allow delete: if signedIn();
    }

    match /groupMembers/{memberId} {
      allow read: if signedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSelfGroupMemberDocument(memberId, request.resource.data);
      allow update: if isSelfGroupMemberDocument(memberId, request.resource.data)
        && request.resource.data.groupId == resource.data.groupId;
      allow update: if isGroupOwner(resource.data.groupId)
        && request.resource.data.diff(resource.data).changedKeys().hasOnly(['role'])
        && request.resource.data.role == "owner";
      allow delete: if signedIn() && resource.data.userId == request.auth.uid;
    }

    match /diaries/{diaryId} {
      allow read, create, update: if signedIn();
    }

    match /stickers/{stickerId} {
      allow read, create, delete: if signedIn();
      allow update: if false;
    }

    match /stickerAssets/{assetId} {
      allow read, create, update, delete: if signedIn();
    }

    match /stickerReports/{reportId} {
      allow create: if signedIn()
        && request.resource.data.reporterId == request.auth.uid
        && reportId == request.resource.data.stickerId + "_" + request.auth.uid
        && request.resource.data.reason == "inappropriate_image"
        && request.resource.data.status == "open";
      allow read, update, delete: if false;
    }

    // The app checks deterministic IDs before creating these documents.
    // Authenticated reads must therefore also work when a document is absent.
    match /friendships/{friendshipId} {
      allow read: if signedIn();
      allow create: if signedIn();
      allow delete: if signedIn()
        && (request.auth.uid == resource.data.userId
          || request.auth.uid == resource.data.friendId);
      allow update: if false;
    }

    match /friendRequests/{requestId} {
      allow read: if signedIn();
      allow create: if signedIn();
      allow update: if signedIn();
      allow delete: if signedIn()
        && (request.auth.uid == resource.data.fromUserId
          || request.auth.uid == resource.data.toUserId);
    }

    match /notifications/{notificationId} {
      allow read, update, delete: if signedIn()
        && (
          request.auth.uid == resource.data.userId
          || request.auth.uid == resource.data.recipientId
        );
      allow create: if signedIn();
    }

    match /editLocks/{diaryId} {
      allow read: if signedIn()
        && (
          resource == null
          || isGroupMember(resource.data.groupId)
        );
      allow create: if hasValidEditLockShape(request.resource.data, diaryId)
        && isGroupMember(request.resource.data.groupId);
      allow update: if hasValidEditLockShape(request.resource.data, diaryId)
        && isGroupMember(request.resource.data.groupId)
        && request.resource.data.groupId == resource.data.groupId
        && request.resource.data.diaryId == resource.data.diaryId
        && (
          resource.data.lockedBy == request.auth.uid
          || resource.data.expiresAt <= request.time
        );
      allow delete: if isGroupMember(resource.data.groupId)
        && resource.data.lockedBy == request.auth.uid;
    }
  }
}
