rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isGroupMember(groupId) {
      return signedIn()
        && exists(/databases/$(database)/documents/groups/$(groupId))
        && request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.memberIds;
    }

    function isGroupOwner(groupId) {
      return signedIn()
        && exists(/databases/$(database)/documents/groups/$(groupId))
        && get(/databases/$(database)/documents/groups/$(groupId)).data.ownerId == request.auth.uid;
    }

    function isSelfGroupMemberDocument(memberId, memberData) {
      return signedIn()
        && memberData.groupId is string
        && memberData.userId == request.auth.uid
        && memberId == memberData.groupId + "_" + request.auth.uid;
    }

    function isFriendInviteGroupMemberDocument(memberId, memberData) {
      return signedIn()
        && memberData.keys().hasOnly([
          "groupId",
          "userId",
          "displayName",
          "avatar",
          "avatarURL",
          "role",
          "joinSource",
          "invitedById",
          "invitedByName",
          "lastReadAt",
          "joinedAt"
        ])
        && memberData.groupId is string
        && memberData.userId is string
        && memberData.displayName is string
        && memberData.avatar is string
        && memberData.avatarURL is string
        && memberData.role == "member"
        && memberData.joinSource == "friend_invite"
        && memberData.invitedById == request.auth.uid
        && memberData.invitedByName is string
        && memberData.lastReadAt is timestamp
        && memberData.joinedAt is timestamp
        && memberData.userId != request.auth.uid
        && memberId == memberData.groupId + "_" + memberData.userId
        && exists(/databases/$(database)/documents/groups/$(memberData.groupId))
        && request.auth.uid in get(/databases/$(database)/documents/groups/$(memberData.groupId)).data.memberIds
        && !(memberData.userId in get(/databases/$(database)/documents/groups/$(memberData.groupId)).data.memberIds)
        && exists(/databases/$(database)/documents/friendships/$(request.auth.uid + "_" + memberData.userId));
    }

    function hasValidEditLockShape(lockData, diaryId) {
      return lockData.keys().hasOnly([
          "groupId",
          "diaryId",
          "lockedBy",
          "lockedByName",
          "expiresAt",
          "updatedAt"
        ])
        && lockData.groupId is string
        && lockData.diaryId == diaryId
        && lockData.lockedBy == request.auth.uid
        && lockData.lockedByName is string
        && lockData.expiresAt is timestamp
        && lockData.expiresAt > request.time
        && lockData.expiresAt <= request.time + duration.value(5, "m");
    }

    function hasValidFriendRequestShape(requestId, requestData) {
      return requestData.keys().hasOnly([
          "fromUserId",
          "fromName",
          "fromAvatar",
          "fromAvatarURL",
          "toUserId",
          "toName",
          "toAvatar",
          "toAvatarURL",
          "status",
          "createdAt",
          "updatedAt"
        ])
        && requestData.fromUserId is string
        && requestData.toUserId is string
        && requestData.fromName is string
        && requestData.toName is string
        && requestData.status is string
        && requestData.createdAt is timestamp
        && requestData.updatedAt is timestamp
        && requestId == requestData.fromUserId + "_" + requestData.toUserId;
    }

    function keepsFriendRequestParties() {
      return request.resource.data.fromUserId == resource.data.fromUserId
        && request.resource.data.fromName == resource.data.fromName
        && request.resource.data.fromAvatar == resource.data.fromAvatar
        && request.resource.data.fromAvatarURL == resource.data.fromAvatarURL
        && request.resource.data.toUserId == resource.data.toUserId
        && request.resource.data.toName == resource.data.toName
        && request.resource.data.toAvatar == resource.data.toAvatar
        && request.resource.data.toAvatarURL == resource.data.toAvatarURL
        && request.resource.data.createdAt == resource.data.createdAt;
    }

    function isAnonymizingOwnSticker() {
      return signedIn()
        && resource.data.authorId == request.auth.uid
        && request.resource.data.authorId == "deleted-user"
        && request.resource.data.authorName == "退会済みユーザー"
        && request.resource.data.authorAvatar == "system:person.fill"
        && request.resource.data.comment == ""
        && request.resource.data.diff(resource.data).changedKeys().hasOnly([
          "authorId",
          "authorName",
          "authorAvatar",
          "comment"
        ]);
    }

    function hasValidFcmTokenShape(tokenData) {
      return tokenData.keys().hasOnly([
          "token",
          "platform",
          "updatedAt"
        ])
        && tokenData.token is string
        && tokenData.platform == "ios"
        && tokenData.updatedAt is timestamp;
    }

    function hasValidStickerUploadJobCreate(jobData) {
      return jobData.keys().hasOnly([
          "userId",
          "assetId",
          "storagePath",
          "downloadURL",
          "originalStoragePath",
          "originalDownloadURL",
          "draft",
          "groupIds",
          "publishToBlog",
          "authorName",
          "authorAvatar",
          "status",
          "createdAt",
          "updatedAt"
        ])
        && jobData.userId == request.auth.uid
        && jobData.assetId is string
        && jobData.storagePath == "stickerAssets/" + request.auth.uid + "/" + jobData.assetId + ".png"
        && jobData.downloadURL is string
        && jobData.originalStoragePath is string
        && jobData.originalDownloadURL is string
        && jobData.draft is map
        && jobData.groupIds is list
        && jobData.publishToBlog is bool
        && jobData.authorName is string
        && jobData.authorAvatar is string
        && jobData.status == "pending"
        && jobData.createdAt is timestamp
        && jobData.updatedAt is timestamp;
    }

    match /users/{userId} {
      allow read: if signedIn();
      allow create, update: if signedIn() && request.auth.uid == userId;
      allow delete: if signedIn() && request.auth.uid == userId;

      match /blockedUsers/{blockedUserId} {
        allow read: if signedIn()
          && (
            request.auth.uid == userId
            || request.auth.uid == blockedUserId
          );
        allow create, update: if signedIn()
          && request.auth.uid == userId
          && userId != blockedUserId
          && request.resource.data.keys().hasOnly([
            "blockerId",
            "blockedUserId",
            "createdAt"
          ])
          && request.resource.data.blockerId == userId
          && request.resource.data.blockedUserId == blockedUserId
          && request.resource.data.createdAt is timestamp;
        allow delete: if signedIn()
          && (
            request.auth.uid == userId
            || (
              request.auth.uid == blockedUserId
              && !exists(/databases/$(database)/documents/users/$(blockedUserId))
            )
          );
      }

      match /fcmTokens/{tokenId} {
        allow read, delete: if signedIn() && request.auth.uid == userId;
        allow create, update: if signedIn()
          && request.auth.uid == userId
          && hasValidFcmTokenShape(request.resource.data);
      }
    }

    match /{path=**}/blockedUsers/{blockedUserId} {
      allow read: if signedIn();
      allow delete: if signedIn()
        && (
          request.auth.uid == resource.data.blockerId
          || request.auth.uid == resource.data.blockedUserId
        );
    }

    match /groups/{groupId} {
      allow read: if signedIn();
      allow create: if signedIn();
      allow update: if signedIn();
      allow delete: if signedIn();
    }

    match /groupMembers/{memberId} {
      allow read: if signedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSelfGroupMemberDocument(memberId, request.resource.data)
        || isFriendInviteGroupMemberDocument(memberId, request.resource.data);
      allow update: if isSelfGroupMemberDocument(memberId, request.resource.data)
        && request.resource.data.groupId == resource.data.groupId;
      allow update: if isGroupOwner(resource.data.groupId)
        && request.resource.data.diff(resource.data).changedKeys().hasOnly(['role'])
        && request.resource.data.role == "owner";
      allow delete: if signedIn() && resource.data.userId == request.auth.uid;
    }

    match /diaries/{diaryId} {
      allow read, create, update: if signedIn();
      allow delete: if signedIn()
        && resource.data.groupId is string
        && isGroupOwner(resource.data.groupId);
    }

    match /stickers/{stickerId} {
      allow read, create, delete: if signedIn();
      allow update: if isAnonymizingOwnSticker();
    }

    match /stickerAssets/{assetId} {
      allow read, create, update, delete: if signedIn();
    }

    match /stickerUploadJobs/{jobId} {
      allow read: if signedIn() && resource.data.userId == request.auth.uid;
      allow create: if signedIn() && hasValidStickerUploadJobCreate(request.resource.data);
      allow delete: if signedIn() && resource.data.userId == request.auth.uid;
      allow update: if false;
    }

    match /stickerReports/{reportId} {
      allow create: if signedIn()
        && request.resource.data.reporterId == request.auth.uid
        && reportId == request.resource.data.stickerId + "_" + request.auth.uid
        && request.resource.data.reason == "inappropriate_image"
        && request.resource.data.status == "open";
      allow read: if signedIn()
        && (
          request.auth.uid == resource.data.reporterId
          || request.auth.uid == resource.data.reportedAuthorId
        );
      allow update: if false;
      allow delete: if signedIn()
        && (
          request.auth.uid == resource.data.reporterId
          || request.auth.uid == resource.data.reportedAuthorId
        );
    }

    // The app checks deterministic IDs before creating these documents.
    // Authenticated reads must therefore also work when a document is absent.
    match /friendships/{friendshipId} {
      allow read: if signedIn();
      allow create: if signedIn();
      allow delete: if signedIn()
        && (request.auth.uid == resource.data.userId
          || request.auth.uid == resource.data.friendId);
      allow update: if false;
    }

    match /friendRequests/{requestId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && hasValidFriendRequestShape(requestId, request.resource.data)
        && request.auth.uid == request.resource.data.fromUserId
        && request.resource.data.fromUserId != request.resource.data.toUserId
        && request.resource.data.status == "pending";
      allow update: if signedIn()
        && hasValidFriendRequestShape(requestId, request.resource.data)
        && keepsFriendRequestParties()
        && request.resource.data.diff(resource.data).changedKeys().hasOnly(["status", "updatedAt"])
        && (
          (
            request.auth.uid == resource.data.toUserId
            && resource.data.status == "pending"
            && request.resource.data.status in ["accepted", "rejected"]
          )
          || (
            request.auth.uid == resource.data.fromUserId
            && resource.data.status in ["accepted", "rejected"]
            && request.resource.data.status == "pending"
          )
        );
      allow delete: if signedIn()
        && (
          request.auth.uid == resource.data.fromUserId
          || request.auth.uid == resource.data.toUserId
        );
    }

    match /notifications/{notificationId} {
      allow read, update, delete: if signedIn()
        && (
          request.auth.uid == resource.data.userId
          || request.auth.uid == resource.data.recipientId
          || request.auth.uid == resource.data.actorId
        );
      allow create: if signedIn();
    }

    // Delivery cadence for the server-generated "one month ago" reminder.
    // Cloud Functions use the Admin SDK; clients may only remove their own
    // state when deleting an account.
    match /memoryReminderStates/{userId} {
      allow read, create, update: if false;
      allow delete: if signedIn() && request.auth.uid == userId;
    }

    match /editLocks/{diaryId} {
      allow read: if signedIn()
        && (
          resource == null
          || resource.data.lockedBy == request.auth.uid
          || isGroupMember(resource.data.groupId)
        );
      allow create: if hasValidEditLockShape(request.resource.data, diaryId)
        && isGroupMember(request.resource.data.groupId);
      allow update: if hasValidEditLockShape(request.resource.data, diaryId)
        && isGroupMember(request.resource.data.groupId)
        && request.resource.data.groupId == resource.data.groupId
        && request.resource.data.diaryId == resource.data.diaryId
        && (
          resource.data.lockedBy == request.auth.uid
          || resource.data.expiresAt <= request.time
        );
      allow delete: if signedIn()
        && resource.data.lockedBy == request.auth.uid;
    }
  }
}
