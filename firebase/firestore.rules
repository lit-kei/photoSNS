rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isGroupMember(groupId) {
      return signedIn()
        && exists(/databases/$(database)/documents/groups/$(groupId))
        && request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.memberIds;
    }

    match /users/{userId} {
      allow read: if signedIn();
      allow create, update: if signedIn() && request.auth.uid == userId;
    }

    match /groups/{groupId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.auth.uid in request.resource.data.memberIds;
      allow update: if isGroupMember(groupId);
    }

    match /groupMembers/{memberId} {
      allow read: if signedIn() && resource.data.userId == request.auth.uid;
      allow create, update: if signedIn() && request.resource.data.userId == request.auth.uid;
    }

    match /diaries/{diaryId} {
      allow read: if isGroupMember(resource.data.groupId);
      allow create: if isGroupMember(request.resource.data.groupId);
      allow update: if isGroupMember(resource.data.groupId)
        && request.resource.data.groupId == resource.data.groupId;
    }

    match /stickers/{stickerId} {
      allow read: if isGroupMember(resource.data.groupId);
      allow create: if signedIn()
        && request.auth.uid == request.resource.data.authorId
        && isGroupMember(request.resource.data.groupId);
      allow delete: if signedIn() && request.auth.uid == resource.data.authorId;
      allow update: if false;
    }

    match /stickerAssets/{assetId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.auth.uid == request.resource.data.ownerId
        && request.resource.data.referenceCount > 0;
      allow update: if signedIn()
        && request.auth.uid == resource.data.ownerId
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.referenceCount > 0;
      allow delete: if signedIn() && request.auth.uid == resource.data.ownerId;
    }

    // The app checks deterministic IDs before creating these documents.
    // Authenticated reads must therefore also work when a document is absent.
    match /friendships/{friendshipId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && (request.auth.uid == request.resource.data.userId
          || request.auth.uid == request.resource.data.friendId);
      allow delete: if signedIn()
        && (request.auth.uid == resource.data.userId
          || request.auth.uid == resource.data.friendId);
      allow update: if false;
    }

    match /friendRequests/{requestId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.auth.uid == request.resource.data.fromUserId
        && request.resource.data.status == "pending";
      allow update: if signedIn()
        && request.resource.data.fromUserId == resource.data.fromUserId
        && request.resource.data.toUserId == resource.data.toUserId
        && (
          (request.auth.uid == resource.data.toUserId
            && request.resource.data.status in ["accepted", "rejected"])
          || (request.auth.uid == resource.data.fromUserId
            && request.resource.data.status == "pending")
        );
      allow delete: if signedIn()
        && (request.auth.uid == resource.data.fromUserId
          || request.auth.uid == resource.data.toUserId);
    }

    match /notifications/{notificationId} {
      allow read, update, delete: if signedIn()
        && request.auth.uid == resource.data.userId;
      allow create: if signedIn();
    }

    match /editLocks/{diaryId} {
      allow read, create, update, delete: if signedIn();
    }
  }
}
